<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PatchTargetVersion Condition="'$(PatchTargetVersion)' == ''">2.4.2</PatchTargetVersion>
    <PatchTargetCommit Condition="'$(PatchTargetCommit)' == ''">8500fcdccaa10b5099ac20d252af3a7c560046f1</PatchTargetCommit>
    <PatchAssemblyVersion Condition="'$(PatchAssemblyVersion)' == ''">2.4.2.1</PatchAssemblyVersion>
    <AssemblyName>Creality-OrcaSlicer-$(PatchTargetVersion)-Patch-Installer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>$(PatchAssemblyVersion)</Version>
    <FileVersion>$(PatchAssemblyVersion)</FileVersion>
    <AssemblyVersion>$(PatchAssemblyVersion)</AssemblyVersion>
    <Product>Creality OrcaSlicer $(PatchTargetVersion) Patch Installer</Product>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PatchTargetVersion" Value="$(PatchTargetVersion)" />
    <AssemblyMetadata Include="PatchTargetCommit" Value="$(PatchTargetCommit)" />
    <EmbeddedResource Include="payload.zip" />
  </ItemGroup>
</Project>
